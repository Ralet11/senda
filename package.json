{
  "name": "senda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "start:prod": "next start -p 3010",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "test": "node --import tsx --conditions=react-server --test tests/*.test.mjs",
    "test:cli": "npm --prefix tools/senda-cli test",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm test && npm run test:cli && npm run typecheck && npm run build",
    "test:browser": "playwright test",
    "test:http": "node --test tests/http/*.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

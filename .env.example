# Copy to .env and use a disposable local PostgreSQL database.
DATABASE_URL="postgresql://senda_demo:senda_demo@127.0.0.1:5432/senda_demo?schema=public"
# Optional: leave empty when exploring the non-AI UI. Never commit a real key.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"
PRISMA_IDEATION_MODEL="gpt-5"
PRISMA_IDEATION_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Enable only for a one-time local seed command, not in a shared environment.
SENDA_ALLOW_DEMO_SEED="false"
# Optional persistent attachment location; default is .uploads/chat.
# SENDA_UPLOADS_ROOT="/absolute/local/path/to/uploads"

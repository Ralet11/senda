// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  ADMIN // Ramiro / equipo interno
  DEV // equipo interno sin control global de la plataforma
  CLIENT
}

enum ProjectMemberRole {
  OWNER // contacto principal del cliente en ese proyecto
  COLLABORATOR // otro miembro del lado del cliente
  TEAM // legado: integrante interno con permisos de responsable
  PROJECT_MANAGER // dev responsable del proyecto
  DEVELOPER // dev asignado al proyecto
}

enum ProjectPhase {
  DISCOVERY
  DESIGN
  DEVELOPMENT
  QA
  LAUNCHED
}

enum ProposalStatus {
  DRAFT
  NEEDS_CLARIFICATION
  SUBMITTED
  IN_REVIEW
  RESPONSE_SENT
  ACCEPTED
  PLANNED
  IN_PROGRESS
  COMPLETED
  DECLINED
  CANCELLED
}

enum ProjectUpdateKind {
  INTERNAL
  CLIENT
}

enum ProjectUpdateStatus {
  DRAFT
  PUBLISHED
  DISCARDED
}

enum ProjectUpdateSource {
  MANUAL
  AGENT
}

enum DevTaskStatus {
  IDEAS
  IN_PROGRESS
  APPLIED
  DONE
}

enum ProjectAgentTokenScope {
  KNOWLEDGE_WRITE
  TASKS_WRITE
  MILESTONES_WRITE
  PROJECT_STATE_WRITE
  UPDATES_WRITE
}

enum ProjectConversationKind {
  DIRECT
}

enum ProjectQuestionStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum AssistantAnswerStatus {
  ANSWERED
  INSUFFICIENT_EVIDENCE
  ANSWERED_BY_TEAM
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  globalRole   GlobalRole @default(CLIENT)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships              ProjectMember[]
  messages                 Message[]
  uploadedAttachments      ChatAttachment[]
  conversationMemberships  ProjectConversationMember[]
  assistantSessions        AssistantSession[]
  reviewedProposals        Proposal[]                  @relation("ProposalReviewer")
  createdProposals         Proposal[]                  @relation("ProposalCreator")
  proposalMessages         ProposalMessage[]
  sessions                 Session[]
  projectUpdates           ProjectUpdate[]
  askedProjectQuestions    ProjectQuestion[]           @relation("ProjectQuestionAsker")
  answeredProjectQuestions ProjectQuestion[]           @relation("ProjectQuestionAnswerer")
}

// Sesión persistida en DB (en vez de JWT) para poder invalidar logins con un delete.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256 del token que viaja en la cookie; nunca guardamos el token en claro
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id                String       @id @default(cuid())
  name              String
  phase             ProjectPhase @default(DISCOVERY)
  progress          Int          @default(0) // 0-100
  summary           String? // brief usado como contexto del AI assistant
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  members           ProjectMember[]
  milestones        Milestone[]
  activityLogs      ActivityLog[]
  messages          Message[]
  attachments       ChatAttachment[]
  conversations     ProjectConversation[]
  assistantSessions AssistantSession[]
  proposals         Proposal[]
  contextChunks     ProjectContextChunk[]
  updates           ProjectUpdate[]
  knowledgeDocuments ProjectKnowledgeDocument[]
  questions         ProjectQuestion[]
  devTasks          DevTask[]
  agentTokens       ProjectAgentToken[]
  agentSyncEvents   ProjectAgentSyncEvent[]
}

model DevTask {
  id          String        @id @default(cuid())
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  title       String
  description String?
  status      DevTaskStatus @default(IDEAS)
  priority    Int           @default(2)
  externalRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([projectId, status, updatedAt])
  @@unique([projectId, externalRef])
}

// Credenciales de integracion por proyecto. Solo se conserva el hash del token;
// el valor en claro se entrega una vez al crearla y se puede revocar en cualquier momento.
model ProjectAgentToken {
  id          String                    @id @default(cuid())
  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  label       String
  tokenHash   String                    @unique
  scopes      ProjectAgentTokenScope[]
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime                  @default(now())
  syncEvents  ProjectAgentSyncEvent[]

  @@index([projectId, revokedAt])
}

// Hace idempotente cada envio de la CLI: reintentar una misma operacion no duplica tareas,
// hitos ni updates si la red se corta despues de que Senda acepto el request.
model ProjectAgentSyncEvent {
  id             String             @id @default(cuid())
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  token          ProjectAgentToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  tokenId        String
  idempotencyKey String
  action         String
  payloadHash    String
  resultJson     String
  createdAt      DateTime           @default(now())

  @@unique([tokenId, idempotencyKey])
  @@index([projectId, createdAt])
}

// Fuente autorizada de lectura. Nunca contiene tokens, credenciales ni URLs privadas.
// Snapshot documental enviado por la CLI. Senda nunca conserva el repositorio ni código fuente.
model ProjectKnowledgeDocument {
  id           String   @id @default(cuid())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  path         String
  content      String
  checksum     String
  sourceCommit String?
  syncedAt     DateTime @default(now())

  @@unique([projectId, path])
  @@index([projectId, syncedAt])
}

// El conocimiento funcional ya no se deriva del codigo: se lee desde `.senda/**/*.md`.

// Registro liviano de errores de backend, redactado, para el panel /admin/console. No reemplaza
// los logs de PM2: es una vista rapida desde el navegador para no tener que entrar por SSH.
model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  detail    String?
  projectId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Evidencia minima de aceptacion de terminos en la experiencia publica de Prisma.
// No contiene mensajes, nombre, email ni direccion IP.
model PublicIdeationConsent {
  id                 String   @id @default(cuid())
  anonymousSessionId String   @unique
  acceptedAt         DateTime
  receivedAt         DateTime @default(now())
  acceptanceMethod   String
  termsVersion       String
  privacyVersion     String
  noticeVersion      String

  @@index([acceptedAt])
}

model ProjectMember {
  id        String            @id @default(cuid())
  role      ProjectMemberRole
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime          @default(now())

  @@unique([projectId, userId])
}

model Milestone {
  id        String    @id @default(cuid())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  title     String
  dueDate   DateTime?
  doneAt    DateTime?
  externalRef String?
  createdAt DateTime  @default(now())

  @@unique([projectId, externalRef])
}

model ActivityLog {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  message   String // ej: "Se completó el login de clientes"
  createdAt DateTime @default(now())
}

model Message {
  id              String               @id @default(cuid())
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  conversation    ProjectConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId  String?
  author          User?                @relation(fields: [authorId], references: [id])
  authorId        String?
  isFromAssistant Boolean              @default(false)
  body            String
  createdAt       DateTime             @default(now())
  attachments     ChatAttachment[]

  @@index([conversationId, createdAt])
}

model ProjectConversation {
  id        String                      @id @default(cuid())
  project   Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  kind      ProjectConversationKind     @default(DIRECT)
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
  members   ProjectConversationMember[]
  messages  Message[]

  @@index([projectId, updatedAt])
}

model ProjectConversationMember {
  id             String              @id @default(cuid())
  conversation   ProjectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  createdAt      DateTime            @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model AssistantSession {
  id            String                @id @default(cuid())
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  title         String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  contextChunks ProjectContextChunk[]
  proposals     Proposal[]
  questions     ProjectQuestion[]

  @@index([projectId, userId, updatedAt])
}

model ChatAttachment {
  id                      String               @id @default(cuid())
  project                 Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId               String
  message                 Message?             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId               String?
  assistantContextChunk   ProjectContextChunk? @relation(fields: [assistantContextChunkId], references: [id], onDelete: Cascade)
  assistantContextChunkId String?
  uploadedBy              User                 @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  uploadedById            String
  storageKey              String               @unique
  fileName                String
  mimeType                String
  sizeBytes               Int
  createdAt               DateTime             @default(now())

  @@index([projectId, createdAt])
  @@index([messageId])
  @@index([assistantContextChunkId])
}

// Idea/pedido que el AI assistant detecta como accionable en una conversación
// y que cae en la bandeja interna para que el equipo la revise.
model Proposal {
  id                 String            @id @default(cuid())
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          String
  createdBy          User?             @relation("ProposalCreator", fields: [createdById], references: [id])
  createdById        String?
  assistantSession   AssistantSession? @relation(fields: [assistantSessionId], references: [id], onDelete: SetNull)
  assistantSessionId String?
  title              String
  description        String
  summary            String?
  openQuestions      String?
  status             ProposalStatus    @default(DRAFT)
  submittedAt        DateTime?
  resolvedAt         DateTime?
  reviewedBy         User?             @relation("ProposalReviewer", fields: [reviewedById], references: [id])
  reviewedById       String?
  messages           ProposalMessage[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

// Historial persistente del assistant. El conocimiento funcional vive en `.senda/**/*.md`.
model ProjectContextChunk {
  id                 String                 @id @default(cuid())
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          String
  assistantSession   AssistantSession?      @relation(fields: [assistantSessionId], references: [id], onDelete: Cascade)
  assistantSessionId String?
  source             String // ej: "brief", "activity_log", "chat"
  content            String
  answerStatus       AssistantAnswerStatus?
  createdAt          DateTime               @default(now())
  attachments        ChatAttachment[]

  @@index([projectId])
  @@index([assistantSessionId, createdAt])
}

// Pregunta que el assistant no pudo responder con la documentacion autorizada.
model ProjectQuestion {
  id                 String                @id @default(cuid())
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          String
  assistantSession   AssistantSession?     @relation(fields: [assistantSessionId], references: [id], onDelete: SetNull)
  assistantSessionId String?
  askedBy            User                  @relation("ProjectQuestionAsker", fields: [askedById], references: [id], onDelete: Cascade)
  askedById          String
  answeredBy         User?                 @relation("ProjectQuestionAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)
  answeredById       String?
  question           String
  answer             String?
  knowledgeCommit    String?
  status             ProjectQuestionStatus @default(OPEN)
  answeredAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([projectId, status, createdAt])
  @@index([askedById, createdAt])
}

model ProposalMessage {
  id         String   @id @default(cuid())
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  @@index([proposalId, createdAt])
}

model ProjectUpdate {
  id                String              @id @default(cuid())
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  kind              ProjectUpdateKind   @default(CLIENT)
  status            ProjectUpdateStatus @default(DRAFT)
  source            ProjectUpdateSource @default(MANUAL)
  title             String
  summary           String
  nextSteps         String?
  risks             String?
  suggestedPhase    ProjectPhase?
  suggestedProgress Int?
  createdByUser     User?               @relation(fields: [createdByUserId], references: [id])
  createdByUserId   String?
  createdByAgent    String?
  publishedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([projectId, status, createdAt])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  ADMIN // Ramiro / equipo interno
  CLIENT
}

enum ProjectMemberRole {
  OWNER // contacto principal del cliente en ese proyecto
  COLLABORATOR // otro miembro del lado del cliente
  TEAM // alguien de Senda trabajando en el proyecto
}

enum ProjectPhase {
  DISCOVERY
  DESIGN
  DEVELOPMENT
  QA
  LAUNCHED
}

enum ProposalStatus {
  DRAFT
  NEEDS_CLARIFICATION
  SUBMITTED
  IN_REVIEW
  RESPONSE_SENT
  ACCEPTED
  PLANNED
  IN_PROGRESS
  COMPLETED
  DECLINED
  CANCELLED
}

enum ProjectUpdateKind {
  INTERNAL
  CLIENT
}

enum ProjectUpdateStatus {
  DRAFT
  PUBLISHED
  DISCARDED
}

enum ProjectUpdateSource {
  MANUAL
  AGENT
}

enum ProjectConversationKind {
  DIRECT
}

enum RepositorySourceKind {
  LOCAL_CHECKOUT
  GIT_MIRROR
}

enum ProjectBrainStatus {
  NOT_SYNCED
  QUEUED
  BUILDING
  READY
  FAILED
  STALE
}

enum ProjectBrainVersionStatus {
  PENDING
  BUILDING
  READY
  FAILED
  SUPERSEDED
}

enum ProjectBrainEvidenceKind {
  PROJECT_DOC
  DOMAIN_DOC
  SCHEMA
  API
  SERVICE
  UI
  TEST
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  globalRole   GlobalRole @default(CLIENT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships             ProjectMember[]
  messages                Message[]
  uploadedAttachments     ChatAttachment[]
  conversationMemberships ProjectConversationMember[]
  assistantSessions       AssistantSession[]
  reviewedProposals       Proposal[]                  @relation("ProposalReviewer")
  createdProposals        Proposal[]                  @relation("ProposalCreator")
  proposalMessages        ProposalMessage[]
  sessions                Session[]
  projectUpdates          ProjectUpdate[]
}

// Sesión persistida en DB (en vez de JWT) para poder invalidar logins con un delete.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256 del token que viaja en la cookie; nunca guardamos el token en claro
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id                String       @id @default(cuid())
  name              String
  phase             ProjectPhase @default(DISCOVERY)
  progress          Int          @default(0) // 0-100
  summary           String? // brief usado como contexto del AI assistant
  repoProvider      String?
  repoLocalPath     String?
  repoDefaultBranch String?
  repoUrl           String? // git remote (SSH) que scripts/sync-repo-clones.ts clona/actualiza; repoLocalPath queda auto-gestionado cuando este campo esta seteado
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  members           ProjectMember[]
  milestones        Milestone[]
  activityLogs      ActivityLog[]
  messages          Message[]
  attachments       ChatAttachment[]
  conversations     ProjectConversation[]
  assistantSessions AssistantSession[]
  proposals         Proposal[]
  contextChunks     ProjectContextChunk[]
  updates           ProjectUpdate[]
  repository        ProjectRepository?
  brainVersions     ProjectBrainVersion[]
  brainEvaluations  ProjectBrainEvaluation[]
}

// Fuente autorizada de lectura. Nunca contiene tokens, credenciales ni URLs privadas.
model ProjectRepository {
  id             String                @id @default(cuid())
  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String                @unique
  kind           RepositorySourceKind  @default(LOCAL_CHECKOUT)
  relativePath   String
  defaultBranch  String?
  lastSeenCommit String?
  lastSeenAt     DateTime?
  worktreeDirty  Boolean               @default(false)
  lastError      String?
  brainStatus    ProjectBrainStatus    @default(NOT_SYNCED)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  brainVersions  ProjectBrainVersion[]
}

// Snapshot inmutable del conocimiento generado desde un commit concreto.
model ProjectBrainVersion {
  id            String                    @id @default(cuid())
  project       Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  repository    ProjectRepository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  repositoryId  String
  commitHash    String
  status        ProjectBrainVersionStatus @default(PENDING)
  filesScanned  Int                       @default(0)
  generatedAt   DateTime?
  failureReason String?
  createdAt     DateTime                  @default(now())
  domains       ProjectBrainDomain[]
  capabilities  ProjectBrainCapability[]
  evidence      ProjectBrainEvidence[]

  @@unique([projectId, commitHash])
  @@index([repositoryId, createdAt])
}

// Dominio funcional apto para explicar al cliente, no una copia del código.
model ProjectBrainDomain {
  id             String                   @id @default(cuid())
  brainVersion   ProjectBrainVersion      @relation(fields: [brainVersionId], references: [id], onDelete: Cascade)
  brainVersionId String
  key            String
  name           String
  description    String
  confidence     String
  createdAt      DateTime                 @default(now())
  capabilities   ProjectBrainCapability[]
  evidence       ProjectBrainEvidence[]

  @@unique([brainVersionId, key])
}

// Capacidad funcional concreta, derivada de un dominio y respaldada por evidencia.
model ProjectBrainCapability {
  id             String                 @id @default(cuid())
  brainVersion   ProjectBrainVersion    @relation(fields: [brainVersionId], references: [id], onDelete: Cascade)
  brainVersionId String
  domain         ProjectBrainDomain?    @relation(fields: [domainId], references: [id], onDelete: SetNull)
  domainId       String?
  key            String
  name           String
  description    String
  confidence     String
  createdAt      DateTime               @default(now())
  evidence       ProjectBrainEvidence[]

  @@unique([brainVersionId, key])
  @@index([domainId])
}

// Evidencia interna: nunca se entrega al cliente ni se usa para exponer código.
model ProjectBrainEvidence {
  id             String                   @id @default(cuid())
  brainVersion   ProjectBrainVersion      @relation(fields: [brainVersionId], references: [id], onDelete: Cascade)
  brainVersionId String
  domain         ProjectBrainDomain?      @relation(fields: [domainId], references: [id], onDelete: Cascade)
  domainId       String?
  capability     ProjectBrainCapability?  @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  capabilityId   String?
  kind           ProjectBrainEvidenceKind
  relativePath   String
  lineStart      Int?
  lineEnd        Int?
  excerpt        String
  fingerprint    String
  createdAt      DateTime                 @default(now())

  @@index([brainVersionId])
  @@index([domainId])
  @@index([capabilityId])
}

// Casos de control que el equipo puede aprobar antes de habilitar el cerebro al cliente.
model ProjectBrainEvaluation {
  id              String   @id @default(cuid())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  title           String
  question        String
  expectedOutcome String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId, isActive])
}

model ProjectMember {
  id        String            @id @default(cuid())
  role      ProjectMemberRole
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime          @default(now())

  @@unique([projectId, userId])
}

model Milestone {
  id        String    @id @default(cuid())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  title     String
  dueDate   DateTime?
  doneAt    DateTime?
  createdAt DateTime  @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  message   String // ej: "Se completó el login de clientes"
  createdAt DateTime @default(now())
}

model Message {
  id              String               @id @default(cuid())
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  conversation    ProjectConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId  String?
  author          User?                @relation(fields: [authorId], references: [id])
  authorId        String?
  isFromAssistant Boolean              @default(false)
  body            String
  createdAt       DateTime             @default(now())
  attachments     ChatAttachment[]

  @@index([conversationId, createdAt])
}

model ProjectConversation {
  id        String                      @id @default(cuid())
  project   Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  kind      ProjectConversationKind     @default(DIRECT)
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
  members   ProjectConversationMember[]
  messages  Message[]

  @@index([projectId, updatedAt])
}

model ProjectConversationMember {
  id             String              @id @default(cuid())
  conversation   ProjectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  createdAt      DateTime            @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model AssistantSession {
  id            String                @id @default(cuid())
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  title         String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  contextChunks ProjectContextChunk[]
  proposals     Proposal[]

  @@index([projectId, userId, updatedAt])
}

model ChatAttachment {
  id                      String               @id @default(cuid())
  project                 Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId               String
  message                 Message?             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId               String?
  assistantContextChunk   ProjectContextChunk? @relation(fields: [assistantContextChunkId], references: [id], onDelete: Cascade)
  assistantContextChunkId String?
  uploadedBy              User                 @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  uploadedById            String
  storageKey              String               @unique
  fileName                String
  mimeType                String
  sizeBytes               Int
  createdAt               DateTime             @default(now())

  @@index([projectId, createdAt])
  @@index([messageId])
  @@index([assistantContextChunkId])
}

// Idea/pedido que el AI assistant detecta como accionable en una conversación
// y que cae en la bandeja interna para que el equipo la revise.
model Proposal {
  id                 String            @id @default(cuid())
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          String
  createdBy          User?             @relation("ProposalCreator", fields: [createdById], references: [id])
  createdById        String?
  assistantSession   AssistantSession? @relation(fields: [assistantSessionId], references: [id], onDelete: SetNull)
  assistantSessionId String?
  title              String
  description        String
  summary            String?
  openQuestions      String?
  status             ProposalStatus    @default(DRAFT)
  submittedAt        DateTime?
  resolvedAt         DateTime?
  reviewedBy         User?             @relation("ProposalReviewer", fields: [reviewedById], references: [id])
  reviewedById       String?
  messages           ProposalMessage[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

// Fragmentos de contexto (brief, docs, historial) embebidos para RAG del AI assistant.
// El embedding se agrega vía migración manual con pgvector (ver docs/ai-assistant.md).
model ProjectContextChunk {
  id                 String                       @id @default(cuid())
  project            Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          String
  assistantSession   AssistantSession?            @relation(fields: [assistantSessionId], references: [id], onDelete: Cascade)
  assistantSessionId String?
  source             String // ej: "brief", "activity_log", "chat"
  content            String
  embedding          Unsupported("vector(1536)")?
  embeddingModel     String?
  embeddedAt         DateTime?
  createdAt          DateTime                     @default(now())
  attachments        ChatAttachment[]

  @@index([projectId])
  @@index([assistantSessionId, createdAt])
}

model ProposalMessage {
  id         String   @id @default(cuid())
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  @@index([proposalId, createdAt])
}

model ProjectUpdate {
  id                String              @id @default(cuid())
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  kind              ProjectUpdateKind   @default(CLIENT)
  status            ProjectUpdateStatus @default(DRAFT)
  source            ProjectUpdateSource @default(MANUAL)
  title             String
  summary           String
  nextSteps         String?
  risks             String?
  suggestedPhase    ProjectPhase?
  suggestedProgress Int?
  createdByUser     User?               @relation(fields: [createdByUserId], references: [id])
  createdByUserId   String?
  createdByAgent    String?
  publishedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([projectId, status, createdAt])
}
